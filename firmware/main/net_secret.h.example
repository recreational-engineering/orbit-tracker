/* Wi-Fi credentials and the network identity the device presents.
 *
 * Copy this file to net_secret.h and fill in your networks. net_secret.h is git-ignored
 * and must never be committed. The device uses the network only to read the current time
 * and to refresh its saved satellite's orbital elements; nothing else is sent or served.
 */
#pragma once

/* Known networks, in order of preference: {ssid, password}. Before joining, the device
 * listens (passive scan, it transmits nothing) for which of them are in range and joins the
 * first one found, so the names of absent networks are never broadcast. */
#define NET_WIFI_NETWORKS { \
    {"your-ssid", "your-password"}, \
    {"other-ssid", "other-password"}, \
}

/* DHCP host name the device presents on the network. */
#define NET_HOSTNAME  "orbit-viewer"
